{
  "name": "dsh-connector-amenities",
  "version": "1.0.0-alpha.1",
  "description": "Optional DSH Connector amenity components (dsh-connector-adapter, dsh-connector-watchdog). Configure each amenity in its component settings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arrosam/dsh-connector.git",
    "directory": "packages/dsh-connector-amenities"
  },
  "publishConfig": {
    "tag": "alpha"
  },
  "type": "module",
  "scripts": {
    "test": "node ../../test/run-package.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "adapter/",
    "watchdog/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14",
    "dsh": ">=0.2.1-rc.5"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
