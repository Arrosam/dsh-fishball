{
  "name": "fishball-amenities",
  "version": "1.0.0-alpha.1",
  "description": "Optional Fishball amenity components (including fishball-board). Configure each amenity in its component settings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arrosam/dsh-fishball.git",
    "directory": "packages/fishball-amenities"
  },
  "publishConfig": {
    "tag": "alpha"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "board/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14",
    "dsh": ">=0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
