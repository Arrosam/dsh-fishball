{
  "schema": "df.ollama-corrected-one-call-literals/v1",
  "sourceOnly": true,
  "sourceDeltaCount": 6,
  "literals": [
    {
      "id": "B01",
      "purpose": "Include the new helper as an exact loaded source dependency.",
      "before": "const loadedProvider = hash(readFileSync(providerPath));\n",
      "after": "const loadedProvider = hash(readFileSync(providerPath));\nconst envelopePath = realpathSync(fileURLToPath(new URL('./ollama-response-envelope.mjs', import.meta.url)));\nconst loadedEnvelope = hash(readFileSync(envelopePath));\n"
    },
    {
      "id": "B02",
      "purpose": "Refuse helper drift during the existing currentness checks.",
      "before": "        hash(readFileSync(providerPath)) !== loadedProvider) deny();\n",
      "after": "        hash(readFileSync(providerPath)) !== loadedProvider ||\n        hash(readFileSync(envelopePath)) !== loadedEnvelope) deny();\n"
    },
    {
      "id": "B03",
      "purpose": "Publish a new source identity that actually binds the helper; do not reuse old source authority.",
      "before": "    sourceRef: canonicalDigest(['df.approved-ollama-source/v1',loadedSource,loadedProvider]),\n",
      "after": "    sourceRef: canonicalDigest(['df.approved-ollama-source/v2',loadedSource,loadedProvider,loadedEnvelope]),\n"
    },
    {
      "id": "B04",
      "purpose": "One issued permit at most in the distinct new binding, retaining one-use consumption and uncertain hold.",
      "before": "          binding.permits.has(agent) || binding.issued >= LIMITS.calls || binding.adapter.audit().uncertainHold) deny();\n",
      "after": "          binding.permits.has(agent) || binding.issued >= 1 || binding.adapter.audit().uncertainHold) deny();\n"
    },
    {
