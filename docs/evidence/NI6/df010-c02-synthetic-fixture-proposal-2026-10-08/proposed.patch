+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { RuntimeStore } from '../src/runtime-store.mjs';
+import { hash, canonicalDigest } from '../src/runtime-security.mjs';
+import { EventRouter } from '../src/events.mjs';
+import { ChatAdapter, chatChannel } from '../src/chat.mjs';
+
+// Proposed source only. Copy to test/df010-c02-synthetic.test.mjs only after
+// owner freeze and independent source/test-design review. No live transport.
+const h = value => hash(`df010-c02-synthetic-${value}`);
+const defer = () => { let resolve; const promise = new Promise(done => { resolve = done; }); return { promise, resolve }; };
+
+function fixture(t, options = {}) {
+  const directory = mkdtempSync(join(tmpdir(), 'df010-c02-synthetic-'));
+  const owner = {}, host = {}, foreignOwner = {};
+  const scope = { ownerId: 'df010-c02-owner', workspaceId: 'df010-c02-workspace' };
+  const state = { now: 1000000, serial: 0, effects: [], sends: [] };
+  const refs = { sourceRef: h('source'), subscriptionRef: h('subscription'), adapterRef: h('adapter'),
+    providerRef: h('provider'), sourceIdentityRef: h('provider-account') };
+  let route = { pairingRef: h('private-pair'), pairingRevision: 1, principalRef: h('principal'),
+    conversationRef: h('conversation'), conversationKind: 'private', threadRef: h('thread-a'), ...options.route };
+  if (route.threadRef === undefined) delete route.threadRef;
+  const config = { databasePath: join(directory, 'ledger.sqlite'), encryptionKey: Buffer.alloc(32, 63),
+    principals: [{ handle: owner, role: 'owner', scope }, { handle: host, role: 'host', scope },
+      { handle: foreignOwner, role: 'owner', scope: { ...scope, ownerId: 'df010-c02-foreign-owner' } }],
+    limits: { maxActive: 8 }, clock: () => state.now, hostPermission: () => true };
+  let store = new RuntimeStore(config);
+  const systems = [], issued = new Map(), command = () => h(`command-${++state.serial}`);
+  const sourceSpec = () => ({ kind: 'chat', identityMode: 'unique_id', enabled: true, adapterRef: refs.adapterRef,
+    permissionPolicyRef: h('private-policy'), maxEventAgeMs: 10000, rate: { windowMs: 60000, maxEvents: 64 }, routeBinding: route });
+  store.configureSource(owner, { commandRef: command(), sourceRef: refs.sourceRef, expectedRevision: 0, spec: sourceSpec() });
+  store.configureSubscription(owner, { commandRef: command(), sourceRef: refs.sourceRef, subscriptionRef: refs.subscriptionRef,
+    expectedRevision: 0, expectedSourceRevision: 1, spec: { enabled: true, triggerRef: h('messages'), route: 'new_task' } });
+  store.policy(owner, { commandRef: command(), expectedVersion: 1, limits: {}, modelPolicy: {
+    version: 1, presetRefs: [h('preset')], catalogEvidenceRef: h('catalog') } });
+  const issue = ({ id = `message-${++state.serial}`, content = 'Synthetic immutable instruction.', observedAt = state.now,
+    eventKind = 'message', intent, proofRoute = route } = {}) => {
+    const payload = { ticket: `ticket-${++state.serial}`, content };
+    issued.set(payload.ticket, { payloadDigest: canonicalDigest(payload), normalized: { content, attachments: [] },
+      proof: { providerRef: refs.providerRef, sourceIdentityRef: refs.sourceIdentityRef, eventIdRef: h(id), observedAt,
+        routeBinding: { ...proofRoute }, eventKind, ...(intent ? { requestDigest: canonicalDigest(intent) } : {}) } });
+    return payload;
+  };
+  const make = () => {
+    const router = new EventRouter({ store, hostHandle: host, clock: () => state.now });
+    const chat = new ChatAdapter({ store, hostHandle: host, router, ...refs, clock: () => state.now,
+      maxAttachments: 0, maxAttachmentBytes: 1,
+      verify: payload => {
+        const fact = issued.get(payload.ticket);
+        if (!fact || fact.payloadDigest !== canonicalDigest(payload)) throw Error('SYNTHETIC_UNISSUED');
+        return fact.proof;
+      }, authorize: () => true, isCurrent: () => true,
+      normalize: (payload, proof) => {
+        const normalized = issued.get(payload.ticket).normalized;
+        return options.normalize ? options.normalize(payload, proof, normalized) : normalized;
+      }, outbound: { authorize: () => true, isCurrent: () => true,
+        send: request => { state.sends.push(request); return { state: 'sent', evidenceRef: h(`send-${state.sends.length}`) }; },
+        query: () => { throw Error('SYNTHETIC_QUERY_NOT_SELECTED'); }, open: () => { throw Error('SYNTHETIC_OPEN_NOT_SELECTED'); } } });
+    systems.push({ router, chat }); return { router, chat };
+  };
+  const f = { ...make(), owner, host, foreignOwner, refs, state, issue, command,
+    get store() { return store; }, get route() { return { ...route }; },
+    ingest: payload => f.chat.ingest({ commandRef: command(), taskId: `task-${++state.serial}`, payload }),
+    setRoute: next => { route = { ...next }; return store.configureSource(owner, { commandRef: command(), sourceRef: refs.sourceRef,
+      expectedRevision: store.source(host, { sourceRef: refs.sourceRef }).revision, spec: sourceSpec() }); },
+    bind: taskRef => { const task = store.task(owner, taskRef); return { taskRef, commandRef: command(),
+      expectedTaskVersion: task.version, expectedAuthEpoch: task.authEpoch }; },
+    receipts: () => store.listEventReceipts(host, { sourceRef: refs.sourceRef, subscriptionRef: refs.subscriptionRef }),
+    rateCount: () => store.source(host, { sourceRef: refs.sourceRef }).rateCount,
+    reopen: () => { for (const item of systems) { item.chat.dispose(); item.router.dispose(); }
+      store.close(); store = new RuntimeStore(config); Object.assign(f, make()); } };
+  f.status = (taskRef, proofRoute = route) => f.chat.status({ taskRef,
+    payload: issue({ eventKind: 'status', proofRoute, intent: { kind: 'status', taskRef } }) });
+  f.control = (taskRef, kind, binding = store.task(owner, taskRef), extra = {}) => {
+    const input = { taskRef, kind, expectedTaskVersion: binding.version, expectedAuthEpoch: binding.authEpoch };
+    const payload = issue({ eventKind: 'control', ...extra, intent: { kind: 'control', taskRef,
+      expectedTaskVersion: input.expectedTaskVersion, expectedAuthEpoch: input.expectedAuthEpoch, control: kind } });
+    return { input: { ...input, payload }, payload };
+  };
+  f.sendRecord = (taskRef, targetRoute = route) => ({ taskRef, recipientRef: targetRoute.principalRef,
+    channelRef: chatChannel({ providerRef: refs.providerRef, sourceIdentityRef: refs.sourceIdentityRef, route: targetRoute }) });
+  f.completeAction = admission => {
+    const generationRef = command(), targetDigest = h('bounded-synthetic-effect-target');
+    const action = store.planAction(owner, { ...f.bind(admission.task.taskRef), spec: { actionRef: command(), kind: 'write', role: 'worker',
+      targetDigest, dataDigest: admission.goalDigest, units: 1,
+      charges: { runtimeMs: 0, usageUnits: 0, costState: 'estimated', costEstimateMicros: 1 },
+      attemptGroupRef: command(), attemptIndex: 1, resourcePolicyVersion: 2, modelPolicyVersion: 1,
+      model: { presetRef: h('preset'), modelRef: h('model'), reasoningRef: h('reasoning'), catalogEvidenceRef: h('catalog') },
+      executor: { mode: 'none', generationRef, environmentRef: h('environment'), bindingDigest: h('binding'),
+        toolsDigest: h('tools'), permissionPolicyDigest: h('permissions') } } });
+    store.grantAction(owner, { ...f.bind(admission.task.taskRef), actionRef: action.actionRef,
+      actionDigest: action.actionDigest, expiresAt: state.now + 100000 });
+    const claim = store.claimAction(host, { ...f.bind(admission.task.taskRef), actionRef: action.actionRef, actionDigest: action.actionDigest });
+    assert.equal(typeof claim.claimRef, 'string'); assert.equal(claim.generationRef, generationRef);
+    // This array append is the entire observable synthetic effect; no tool,
+    // model, account, listener, native session or external recipient exists.
+    state.effects.push({ actionRef: action.actionRef, targetDigest, dataDigest: admission.goalDigest });
+    store.settleAction(host, { taskRef: admission.task.taskRef, commandRef: command(), claimRef: claim.claimRef, generationRef,
+      outcome: 'completed', evidenceRef: h('synthetic-effect-append') });
+    assert.equal(store.snapshot(owner, { taskRef: admission.task.taskRef }).actions[0].state, 'completed');
+    return action;
+  };
+  t.after(() => { for (const item of systems) { item.chat.dispose(); item.router.dispose(); }
+    try { store.close(); } finally { rmSync(directory, { recursive: true, force: true }); } });
+  return f;
+}
+
+function conserved(f, admission) {
+  const snapshot = f.store.snapshot(f.owner, { taskRef: admission.task.taskRef });
+  return { task: snapshot.task, actions: snapshot.actions, data: snapshot.data, control: snapshot.control,
+    receipt: f.store.eventReceipt(f.host, { sourceRef: f.refs.sourceRef, subscriptionRef: f.refs.subscriptionRef, eventRef: admission.eventRef }),
+    goal: f.store.readData(f.owner, { taskRef: admission.task.taskRef, recordRef: admission.goalRecordRef }), effects: [...f.state.effects] };
+}
+const assertConserved = (f, admission, before) => assert.deepEqual(conserved(f, admission), before);
+test('C02 changed thread never inherits original action, route, task access or reply scope', { timeout: 5000 }, async t => {
+  for (const mode of ['replace', 'add', 'remove']) await t.test(mode, async t => {
+    const f = fixture(t, { route: mode === 'add' ? { threadRef: undefined } : {} });
+    const originalRoute = f.route, id = 'same-provider-message';
+    const originalPayload = f.issue({ id }), original = await f.ingest(originalPayload);
+    f.completeAction(original); const before = conserved(f, original);
+    const originalGoal = JSON.parse(before.goal.content);
+    assert.equal(originalGoal.originalEventIdRef, h(id)); assert.equal(originalGoal.routeDigest, canonicalDigest(originalRoute));
+    assert.equal(originalGoal.content, originalPayload.content);
+    const changedRoute = { ...originalRoute, threadRef: h('thread-b') };
+    if (mode === 'remove') delete changedRoute.threadRef;
+    const send = f.chat.recipientAdapter(), originalRecord = f.sendRecord(original.task.taskRef, originalRoute);
+    assert.equal((await send.send(originalRecord, { content: 'Synthetic route probe.' })).state, 'sent');
+    assert.deepEqual(f.state.sends[0].route, originalRoute);
+    assert.throws(() => f.store.snapshot(f.foreignOwner, { taskRef: original.task.taskRef }));
+    await assert.rejects(f.ingest(f.issue({ id, proofRoute: changedRoute })), { code: 'ROUTE_MISMATCH' });
+    await assert.rejects(f.status(original.task.taskRef, changedRoute), { code: 'ROUTE_MISMATCH' });
+    const wrongThreadControl = f.control(original.task.taskRef, 'cancel', before.task, { proofRoute: changedRoute });
+    await assert.rejects(f.chat.control(wrongThreadControl.input), { code: 'ROUTE_MISMATCH' });
+    assertConserved(f, original, before); assert.equal(f.rateCount(), 1);
+    f.setRoute(changedRoute);
+    await assert.rejects(f.ingest(originalPayload), { code: 'ROUTE_MISMATCH' });
+    await assert.rejects(f.status(original.task.taskRef), { code: 'ROUTE_MISMATCH' });
+    await assert.rejects(f.chat.control(f.control(original.task.taskRef, 'cancel', before.task).input), { code: 'ROUTE_MISMATCH' });
+    await assert.rejects(send.send(originalRecord, { content: 'Synthetic route probe.' }), { code: 'CHAT_DELIVERY_ROUTE' });
+    await assert.rejects(send.send(f.sendRecord(original.task.taskRef), { content: 'Synthetic route probe.' }), { code: 'ROUTE_MISMATCH' });
+    assert.equal(f.state.sends.length, 1); assertConserved(f, original, before);
+    const changed = await f.ingest(f.issue({ id, content: 'A separate instruction in the changed thread.' }));
+    assert.equal(changed.deduplicated, false); assert.notEqual(changed.eventRef, original.eventRef);
+    assert.notEqual(changed.task.taskRef, original.task.taskRef);
+    assert.equal(changed.routeBindingDigest, canonicalDigest(changedRoute));
+    assert.equal(original.routeBindingDigest, canonicalDigest(originalRoute));
+    const changedGoal = JSON.parse(f.store.readData(f.owner, { taskRef: changed.task.taskRef, recordRef: changed.goalRecordRef }).content);
+    assert.equal(changedGoal.originalEventIdRef, h(id)); assert.equal(changedGoal.routeDigest, canonicalDigest(changedRoute));
+    assert.notEqual(changedGoal.routeDigest, originalGoal.routeDigest);
+    assert.equal((await f.status(changed.task.taskRef)).task.taskRef, changed.task.taskRef);
+    assert.equal((await send.send(f.sendRecord(changed.task.taskRef), { content: 'Synthetic changed-thread probe.' })).state, 'sent');
+    assert.deepEqual(f.state.sends[1].route, changedRoute);
+    assert.equal(f.store.listTasks(f.owner).length, 2); assert.equal(f.receipts().length, 2); assert.equal(f.rateCount(), 2);
+    assertConserved(f, original, before);
+    f.setRoute(originalRoute);
+    const duplicate = await f.ingest(originalPayload);
+    assert.equal(duplicate.deduplicated, true); assert.equal(duplicate.task.taskRef, original.task.taskRef);
+    assert.equal((await f.status(original.task.taskRef)).task.taskRef, original.task.taskRef);
+    await assert.rejects(f.status(changed.task.taskRef), { code: 'ROUTE_MISMATCH' });
+    assertConserved(f, original, before); assert.equal(f.state.effects.length, 1); assert.equal(f.rateCount(), 2);
+  });
+});
+
+test('C02 an older pending message cannot cross a thread reconfiguration or overwrite the later admission', { timeout: 5000 }, async t => {
+  const reached = defer(), gate = defer(); let blockedTicket;
+  t.after(() => gate.resolve());
+  const f = fixture(t, { normalize: async (payload, proof, normalized) => {
+    if (payload.ticket === blockedTicket) { reached.resolve(); await gate.promise; } return normalized;
+  } });
+  const oldRoute = f.route, older = f.issue({ id: 'reordered-shared-id', observedAt: f.state.now - 100 });
+  blockedTicket = older.ticket;
+  const pending = f.ingest(older); await reached.promise;
+  f.setRoute({ ...oldRoute, threadRef: h('thread-b') });
+  const later = await f.ingest(f.issue({ id: 'reordered-shared-id', observedAt: f.state.now - 10, content: 'Later thread instruction.' }));
+  f.completeAction(later); const before = conserved(f, later);
+  gate.resolve(); await assert.rejects(pending, { code: 'STALE_SOURCE' });
+  assertConserved(f, later, before);
+  assert.equal(f.store.listTasks(f.owner).length, 1); assert.equal(f.receipts().length, 1); assert.equal(f.rateCount(), 1);
+  assert.equal(f.receipts()[0].routeBindingDigest, canonicalDigest(f.route));
+  await assert.rejects(f.status(later.task.taskRef, oldRoute), { code: 'ROUTE_MISMATCH' });
+});
+
+test('C02 later-before-earlier unique messages remain separate; exact redelivery and reopen cannot replay the action', { timeout: 5000 }, async t => {
+  const f = fixture(t), route = f.route;
+  const newerPayload = f.issue({ id: 'newer', content: 'Newer distinct instruction.', observedAt: f.state.now - 10 });
+  const olderPayload = f.issue({ id: 'older', content: 'Older distinct instruction.', observedAt: f.state.now - 100 });
+  const newer = await f.ingest(newerPayload); f.completeAction(newer); const before = conserved(f, newer);
+  const older = await f.ingest(olderPayload);
+  assert.equal(older.deduplicated, false); assert.notEqual(older.eventRef, newer.eventRef); assert.notEqual(older.task.taskRef, newer.task.taskRef);
+  assert.ok(older.observedAt < newer.observedAt); assert.equal(older.receivedAt, newer.receivedAt);
+  assert.equal(JSON.parse(f.store.readData(f.owner, { taskRef: older.task.taskRef, recordRef: older.goalRecordRef }).content).content, olderPayload.content);
+  assert.equal(JSON.parse(before.goal.content).content, newerPayload.content);
+  const expectedEventRef = id => canonicalDigest({ providerRef: f.refs.providerRef, sourceIdentityRef: f.refs.sourceIdentityRef,
+    origin: { principalRef: route.principalRef, conversationRef: route.conversationRef, conversationKind: route.conversationKind,
+      threadRef: route.threadRef }, identityMode: 'unique_id', identityRef: h(id) });
+  assert.equal(newer.eventRef, expectedEventRef('newer')); assert.equal(older.eventRef, expectedEventRef('older'));
+  assert.equal(newer.identityLimit, 'complete_event_identity'); assert.equal(older.identityLimit, 'complete_event_identity');
+  for (const [payload, original] of [[olderPayload, older], [newerPayload, newer]]) {
+    const duplicate = await f.ingest(payload);
+    assert.equal(duplicate.deduplicated, true); assert.equal(duplicate.task.taskRef, original.task.taskRef); assert.equal(duplicate.eventDigest, original.eventDigest);
+  }
+  await assert.rejects(f.ingest(f.issue({ id: 'newer', content: 'Late same-ID replacement.', observedAt: f.state.now - 200 })), { code: 'IDEMPOTENCY_CONFLICT' });
+  assertConserved(f, newer, before); assert.equal(f.rateCount(), 2); assert.equal(f.receipts().length, 2);
+  f.reopen(); assertConserved(f, newer, before);
+  for (const [payload, original] of [[newerPayload, newer], [olderPayload, older]]) {
+    const duplicate = await f.ingest(payload); assert.equal(duplicate.deduplicated, true); assert.equal(duplicate.task.taskRef, original.task.taskRef);
+  }
+  assertConserved(f, newer, before); assert.equal(f.state.effects.length, 1);
+  assert.equal(f.store.listTasks(f.owner).length, 2); assert.equal(f.rateCount(), 2);
+});
+
+test('C02 reordered edits and deletes are explicit denials before and after original action admission', { timeout: 5000 }, async t => {
+  const f = fixture(t), id = 'mutation-before-original';
+  for (const eventKind of ['delete', 'edit']) await assert.rejects(f.ingest(f.issue({ id, eventKind,
+    content: 'Mutation arrives first.', observedAt: f.state.now - 10 })), { code: 'EVENT_MUTATION_DENIED' });
+  assert.equal(f.store.listTasks(f.owner).length, 0); assert.equal(f.receipts().length, 0); assert.equal(f.rateCount(), 0);
+  const originalPayload = f.issue({ id, content: 'Original explicit instruction.', observedAt: f.state.now - 100 });
+  const original = await f.ingest(originalPayload); f.completeAction(original); const before = conserved(f, original);
+  for (const eventKind of ['edit', 'delete']) await assert.rejects(f.ingest(f.issue({ id, eventKind,
+    content: 'Late mutation cannot amend executed authority.', observedAt: f.state.now - 200 })), { code: 'EVENT_MUTATION_DENIED' });
+  await assert.rejects(f.ingest(f.issue({ id, content: 'Changed message guise.', observedAt: f.state.now - 300 })), { code: 'IDEMPOTENCY_CONFLICT' });
+  const duplicate = await f.ingest(originalPayload);
+  assert.equal(duplicate.deduplicated, true); assert.equal(duplicate.task.taskRef, original.task.taskRef);
+  assertConserved(f, original, before); assert.equal(f.receipts().length, 1); assert.equal(f.rateCount(), 1);
+});
+
+test('C02 stale first-seen delivery rejects; exact known expired redelivery reconciles without replacing or replaying', { timeout: 5000 }, async t => {
+  const f = fixture(t), originalPayload = f.issue({ id: 'known-original' }), original = await f.ingest(originalPayload);
+  f.completeAction(original); const before = conserved(f, original);
+  await assert.rejects(f.ingest(f.issue({ id: 'expired-unseen', observedAt: f.state.now - 10001 })), { code: 'EVENT_EXPIRED' });
+  assertConserved(f, original, before); assert.equal(f.receipts().length, 1); assert.equal(f.rateCount(), 1);
+  const boundary = await f.ingest(f.issue({ id: 'at-age-boundary', observedAt: f.state.now - 10000 }));
+  assert.equal(boundary.deduplicated, false); assert.notEqual(boundary.task.taskRef, original.task.taskRef);
+  f.state.now += 10001;
+  const duplicate = await f.ingest(originalPayload);
+  assert.equal(duplicate.deduplicated, true); assert.equal(duplicate.eventDigest, original.eventDigest);
+  assert.equal(duplicate.task.taskRef, original.task.taskRef);
+  await assert.rejects(f.ingest(f.issue({ id: 'known-original', observedAt: 1000000, content: 'Expired changed same-ID instruction.' })), { code: 'IDEMPOTENCY_CONFLICT' });
+  assertConserved(f, original, before); assert.equal(f.state.effects.length, 1);
+  assert.equal(f.store.listTasks(f.owner).length, 2); assert.equal(f.receipts().length, 2); assert.equal(f.rateCount(), 2);
+});
+
+test('C02 reordered stale control cannot overwrite a newer accepted control; exact newer duplicate applies once', { timeout: 5000 }, async t => {
+  const f = fixture(t), admission = await f.ingest(f.issue({ id: 'control-task' }));
+  f.completeAction(admission); const originalTask = f.store.task(f.owner, admission.task.taskRef);
+  const lateCancel = f.control(admission.task.taskRef, 'cancel', originalTask, { id: 'older-control', observedAt: f.state.now - 100 });
+  const newerPause = f.control(admission.task.taskRef, 'pause', originalTask, { id: 'newer-control', observedAt: f.state.now - 10 });
+  const pause = await f.chat.control(newerPause.input), before = conserved(f, admission);
+  assert.equal(before.control, 'paused'); assert.equal(pause.task.version, originalTask.version + 1);
+  await assert.rejects(f.chat.control(lateCancel.input), { code: 'STALE_VERSION' });
+  const duplicate = await f.chat.control(newerPause.input);
+  assert.equal(duplicate.task.version, pause.task.version);
+  assertConserved(f, admission, before); assert.equal(f.state.effects.length, 1); assert.equal(f.rateCount(), 1);
+});
