  "findings": [
    {
      "id": "SC-F01",
      "severity": "MEDIUM",
      "status": "OPEN",
      "sourceDisposition": "REMEDIATION_REQUIRED_BEFORE_ADOPTION",
      "origin": "Inherited primary-model validation gap left unresolved by this proposal",
      "title": "Selected status/detail scope is not anchored to the genuine listed task",
      "locations": [
        {
          "path": ".runtime/ni4-scope-timer-proposal/src/client-entry.cjs",
          "lines": [
            65,
            73,
            78,
            79,
            87,
            90,
            91,
            92
          ]
        }
      ],
      "sourceTrace": [
        "refresh validates and retains listed ownerRef/workspaceRef/taskRef with safeTask at line65.",
        "select line73 admits only a matching listed taskRef; it does not capture the listed owner/workspace before marking selection/loading at line75.",
        "workerTask closes the nine-key status task at line78, but line79 compares only returned taskRef to the requested taskRef.",
        "Detail line87 joins owner/workspace/task/version/authEpoch to the returned status task, without anchoring that status task to the listed task.",
        "If a complete valid status task retains the selected taskRef and changes ownerRef or workspaceRef, it passes these comparisons; empty data reaches lines91–92 directly. Consistent detail tasks can additionally publish records.",
        "Lines91–92 replace the known listed task scope and publish detail/records with phase=ready and stale=false.",
        "Original RuntimeStore taskRef is reference(taskId) at line373; owner/workspace remain separate keys at lines193–198, so taskRef equality does not imply scope equality."
      ],
      "impact": "A mismatched source reply can replace a known listed owner/workspace and reach the primary task panel. This is bounded client validation evidence, not an original server authorization bypass: original list/status/detail remain owner-handle-scoped. Normal memory uses an independent authenticated feature anchor and rejects the conflicting selected scope.",
      "remediation": [
        "Capture the actual existing listed task before request publication; do not fabricate a selected task if it is absent.",
        "Join status ownerRef/workspaceRef/taskRef to that captured list scope before any detail request or reply-derived state publication.",
        "Retain the closed detail join, and recheck the current listed owner/workspace/task and selection/read lifetime immediately before final task/detail/record publication.",
        "Do not require the status version/authEpoch to equal a possibly older list snapshot; legitimate fresher authoritative status must still work.",
        "Preserve intake/refresh behavior: intake may temporarily select a returned taskRef before listing, but refresh must establish the actual list row (or select null), and direct select of an absent row must remain denied."
      ],
      "affectedSourceCriteria": [
        "BUB006-01 / DF006-01",
        "BUB014-01 / DF014-01",
        "BUB014-05 / DF014-05",
        "BUB016-01 / DF016-01"
      ],
      "affectedObligations": [
        "SC-O04",
        "SC-O05",
        "SC-O07"
      ],
      "runtimeEvidence": "NOT_RUN"
    },
    {
      "id": "SC-F02",
      "severity": "MEDIUM",
      "status": "OPEN",
      "sourceDisposition": "REMEDIATION_REQUIRED_BEFORE_ADOPTION",
      "origin": "Inherited parent read-lifetime race relied on by the new featureScope guard",
      "title": "An older selection read can erase a newer list refresh loading/stale fence",
      "locations": [
        {
          "path": ".runtime/ni4-scope-timer-proposal/src/client-entry.cjs",
          "lines": [
            36,
            60,
            61,
            74,
            90,
            92,
            692,
            694,
            734,
            738
          ]
        }
      ],
      "sourceTrace": [
        "An existing select captures detailRevision at line74 and waits for status/detail.",
        "A newer refresh increments only list revision at line60, then publishes loading/stale at line61.",
        "Before that newer list request finishes, the older selection read may finish while active, detailRevision and selected taskRef still match line90.",
        "Line92 then publishes ready/stale=false; no list revision or pending-list check prevents it.",
        "featureScope lines692–695 treats that restored parent snapshot as fresh, so the promised loading/stale admission fence can reopen while the authoritative newer list read is still outstanding."
      ],
      "impact": "The client can label an old selection current during an ongoing refresh and permit scoped UI/admission on that state. Original server owner/CAS fences are unchanged, and this trace does not prove a cross-owner server read or successful stale mutation.",
      "remediation": [
        "Invalidate older detail-read lifetimes when a newer list refresh starts.",
        "Make selection readiness/publication respect the current list read generation and pending refresh, including selection requests initiated during loading.",
        "Retain the existing latest-list selection and empty-list clearing behavior; a superseded read must not manufacture a ready selected task.",
        "Review pending normal memory and task-scoped operations after the parent lifetime correction on a separately frozen amendment."
      ],
      "affectedSourceCriteria": [
        "BUB008-05 / DF008-05",
        "BUB014-01 / DF014-01",
        "BUB014-03 / DF014-03",
        "BUB016-01 / DF016-01"
      ],
      "affectedObligations": [
        "SC-O04",
        "SC-O05",
        "SC-O07"
      ],
      "runtimeEvidence": "NOT_RUN"
    }
  ],
  "sourceObservations": [
    {
      "id": "SC-R01",
      "status": "SOURCE_SUPPORTED_NOT_RUN",
      "subject": "Authentic feature owner/namespace origin and original guards",
      "evidence": [
        "runtime-plugin.mjs:96–107,137,163–183,474–493",
        "runtime-store.mjs:1368–1372",
        "memory.mjs:42–61",
        "installed-memory.mjs:46–54",
        "installed-plugin.mjs:29–30,59–66,82–99"
      ],
      "conclusion": "Original RuntimeStore.memoryBinding(owner) resolves the original private owner principal; diagnostics checks installedAlive before and after that metadata read and requires role=owner. Namespace is the frozen trusted constructor selection also supplied to original MemoryAdapter. Original owner-call carriers/store authority checks remain. Setup route retains authenticated peer and repeats same-child/lifetime/setup checks after the complete diagnostics read. No payload/body establishes initial scope."
    },
    {
      "id": "SC-R02",
      "status": "SOURCE_SUPPORTED_NOT_RUN",
      "subject": "No-task initial memory denial and private feature pinning",
      "evidence": [
        "client-entry.cjs:620–630,684–728,741–752,801–804,897"
      ],
      "conclusion": "Memory operations cannot proceed before authenticated features and ready continuity. Closed top-level and memory scopes join owner/workspace, and later feature responses must retain initial owner/workspace/namespace until disconnect. Fresh ready selected=null/detail absent admits genuine owner private memory without inventing a task. Unavailable features clear usable views but do not silently rebind. These conclusions depend on the original authenticated route, not fabricated mutually consistent initial data."
    },
    {
      "id": "SC-R03",
      "status": "SOURCE_SUPPORTED_NOT_RUN_WITH_PARENT_FINDINGS",
      "subject": "Post-await memory currentness and foreign reply publication ordering",
      "evidence": [
        "client-entry.cjs:688–707,733–754,801–832"
      ],
      "conclusion": "Before send and every update, normal operations validate the captured feature binding against current ready/non-stale parent scope. memoryRead joins namespace, projection scope and core scope before memory publication; memory receipts and import preview also join the pinned scope. During an actual loading/stale/offline or foreign owner/workspace parent, post-await parsing/update denies before reply/body/binding publication. Same-owner task switching can admit private namespace reads once current selection is ready because memory is owner/workspace namespace state; task-scoped runs additionally compare captured taskRef/version/authEpoch. Malformed sent mutation replies remain uncertain. SC-F02 limits the trustworthiness of the parent stale/ready flag."
    },
    {
      "id": "SC-R04",
      "status": "SOURCE_SUPPORTED_NOT_RUN",
      "subject": "Original nested local-delivery grant shape and joins",
      "evidence": [
        "client-entry.cjs:325–327,738,744–752,789–794,831–836",
        "approval-preview.mjs:122–145",
        "runtime-store.mjs:24–26,613–630"
      ],
      "conclusion": "The actual store returns the full nine-key taskRecord, retains task version, and increments authEpoch by one. Original ApprovalPreview returns that receipt. Client requires CAS, closes both grant and nested task, and joins owner/workspace to feature and selected task plus taskRef/action/digest/expiry/version/authEpoch to the request before grant/reply publication. No synthetic positive grant/currentness evidence is established."
    },
    {
      "id": "SC-R05",
      "status": "SOURCE_SUPPORTED_COMPATIBILITY_NOT_RUN",
      "subject": "Global safeTask requirements versus original API outputs",
      "evidence": [
        "client-entry.cjs:24–26,59–94,111–124,325–327",
        "runtime-store.mjs:24–26,366–399,1288–1302",
        "runtime-plugin.mjs:364–366,424–432",
        "coordinator.mjs:58–61,80"
      ],
      "conclusion": "Original list/intake/status/detail forward complete taskRecord with owner/workspace. The global safeTask change retains required scope in sanitized UI tasks; the original closed workerTask accepts actual raw nine-key outputs and returns that sanitized task. The shared worker/audit consumers now also require scope through safeTask/workerTask. Source contract is compatible; no legacy partial synthetic fixture was read, altered, or promoted to actual API evidence. Broader worker/audit runtime regression remains NOT_RUN."
    },
    {
      "id": "SC-R06",
      "status": "SOURCE_SUPPORTED_NOT_RUN",
      "subject": "Trusted constructor-only schedule clock/timer forwarding",
      "evidence": [
        "runtime-plugin.mjs:34–49,299,328–329",
        "installed-normal-services.mjs:20–24,41–57",
        "scheduler.mjs:16–29,130–160",
        "installed-events.mjs:179–211",
        "installed-plugin.mjs:36–42",
        "installed-config.mjs:7–10"
      ],
      "conclusion": "Only private constructor scheduleClock/scheduleTimers are added; validation forbids invalid shapes without invoking callbacks. They reach the actual original ScheduleDriver clock/timers slots through createNormalAutomation. Timer object receiver is retained for set/clear. No imports, start/register/tick, timer facade, RPC/config/persistence seam, or replacement driver is added. Installed apply omits both options and keeps original Date.now/setTimeout/clearTimeout defaults. Generic automation also retains defaults. Seam controls only ScheduleDriver, while RuntimeStore/other clocks remain real; finite source-composer callback design cannot claim exact packed installed-entry timer acceptance."
    }
  ],
