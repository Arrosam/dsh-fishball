  "independentOracles": [
    {
      "id": "N5C6-01",
      "covers": [
        "N5-08",
        "N5-09",
        "N5-16"
      ],
      "oracle": "Genuine current source-native artifact/accepted exact delivery/grant/policy and full byte charge admit one typed claim. Its claim/reservation/worker/outbox/task/frequency/group/fact changes are one original transaction; return exactly the original seven-key flat claim receipt. Root's normal ResultPipeline slot invokes claimLocalDelivery once before send; no new public route/flag/queue/handle.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-02",
      "covers": [
        "N5-01",
        "N5-02",
        "N5-06",
        "N5-07",
        "N5-08",
        "N5-16"
      ],
      "oracle": "Extra normal/proof/result/callback/outbox/auditRepair keys, unsafe descriptors/Proxy, wrong opaque scope/role, mismatched action/delivery/digests, absent/raw/unavailable native verification, stale material/semantic/currentness, revoked/expired grant, paused/cancelled task, stale policy or denied private permission refuse before any new attempt/reservation/outbox/frequency/fact/send. Preserve storage/crypto errors; do not classify them as native denial or manufacture receipts.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-03",
      "covers": [
        "N5-06",
        "N5-16",
        "N5-20"
      ],
      "oracle": "Independently size complete canonical publication UTF8 envelope B against approved usageUnits U, including content/metadata/escaping/CJK/astral characters. B=U-1 and B=U may pass all other gates; B=U+1 refuses at typed claim with zero claim writes, and at publication with original claim/hold retained but zero sent mutation. No truncation/content-only charge or widening.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-04",
      "covers": [
        "N5-06",
        "N5-08",
        "N5-09",
        "N5-21"
      ],
      "oracle": "Unmarked advanced executor:none with legacy accepted verification/runtimeMs0/usageUnits0 retains the original advanced claim behavior/receipt; no full local source classification from none alone. Normal typed claim on that raw source refuses. Sticky signed normal policy forces exact signed progress/manifest/native/full-byte checks even through generic claimAction. Every publishLocalDelivery path repeats full local predicates.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-05",
      "covers": [
        "N5-09",
        "N5-11",
        "N5-14",
        "N5-16"
      ],
      "oracle": "Exact typed same-command/input replay returns only the original claim receipt before fresh mutational CAS, with zero extra attempt/reservation/outbox/group/fact/window/send. Changed same command conflicts. Generic-versus-typed crossing the same existing keyed command ID conflicts in both orders because operation names remain distinct. Overlapping duplicates admit at most one claim. Reopen/unknown/query does not authorize another send.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-06",
      "covers": [
        "N5-05",
        "N5-06",
        "N5-07",
        "N5-14"
      ],
      "oracle": "Create authentic current progress P for source artifact A, then exact notification manifest artifact B and its independent review using existing permitted statement bytes. If shared semantic/material/verification authority did not change, configuring/passing B's audit does not change P.sourceStates/progressDigest/currentness or cause circular manifest mismatch. P.sourceStates contains only requirements whose selected artifactRef is A; caller IDs never choose the filter.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-07",
      "covers": [
        "N5-05",
        "N5-07",
        "N5-14",
        "N5-21"
      ],
      "oracle": "For selected artifact A retain applicable historical/current version audit states, findings, native report, material, round and repair facts in the held closed layout. Rebind/revision/round/selected material/native verification changes stale the old report, as do actual task semantic/protected-context changes. Old-version stale facts cannot disappear/become passed; historical signed snapshots remain immutable. Preserve all eight precedence outcomes and factual dedup exclusions; routine claim/grant/progress task CAS alone does not stale.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-08",
      "covers": [
        "N5-06",
        "N5-07",
        "N5-08",
        "N5-09"
      ],
      "oracle": "Although P's selected-artifact status can stay current/passed, another required pending/failed/unknown/budget/fatal/stale audit still refuses normal claim/publication. B itself needs current independent authentic native review with full selected original-goal/scope/unfinished/next/blocker exact record+digest coverage. Reference-only review, omitted/changed selected statement bytes, raw progress or unavailable provenance cannot publish; an unrelated passing audit clears neither gate.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-09",
      "covers": [
        "N5-09",
        "N5-14",
        "N5-16",
        "N5-17"
      ],
      "oracle": "After one valid claim force two real connection/order cases for revoke/control/policy/artifact/source/semantic/byte/coverage drift against publication: drift first refuses sent while retaining committed claim/hold; publication first preserves exact durable sent/opening-unknown receipt and ownership. Publication validates the original same group/facts/window/resource claim and succeeds without a second charge at frequency full/minInterval, while a competing new claim refuses. No own-pending-group conflict.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    },
    {
      "id": "N5C6-10",
      "covers": [
        "N5-10",
        "N5-11",
        "N5-17",
        "N5-18"
      ],
      "oracle": "Permitted before_commit/after_claim and publication/response-loss cuts preserve the single original atomic receipt/reservation/outbox/counter boundaries. Committed publication followed by lost return/restart is reconciled only by reading genuine stored association; no automatic resend, native claim, reviewer/provider request or replay on boot/status/query. Callback echo/opened flag cannot prove sent/delivered; sent remains opening unknown. Cold capability/currentness re-resolves without reconstructing missing source origin.",
      "status": "NOT_RUN",
      "evidenceRequired": "T only call/decision carriers; genuine6 D for atomic/signed/byte/race/recovery, actual N/P for original native/physical authority."
    }
  ],
