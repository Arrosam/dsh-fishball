+    // Two finite public event-loop turns, no private queue/clock instrumentation.
+    await waitFor(new Promise(resolve=>setImmediate(resolve)),signal);
+    await waitFor(new Promise(resolve=>setImmediate(resolve)),signal);
+    assert.deepEqual(counts(),before,'no input-independent request loop');
+  }
