{
  "name": "dsh-fishball",
  "private": true,
  "description": "Fishball, DSH Connector and hosted Fishball in one repository. The root is not a plugin package.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "dsh-fishball/packages/core",
    "amenities/board",
    "amenities/heartbeat",
    "amenities/taskboard",
    "amenities/consultant",
    "amenities/fishball-amenities",
    "dsh-fishball/packages/shared",
    "dsh-fishball/packages/test-helpers",
    "dsh-fishball/packages/integration-*",
    "dsh-fishball/packages/core/ui",
    "dsh-fishball/packages/core/ui/fishball-child-plugins",
    "dsh-fishball/packages/core/ui/fishball-page",
    "dsh-fishball/packages/core/ui/fishball-recommend-plugins",
    "dsh-connector/packages/dsh-connector",
    "dsh-connector/packages/dsh-connector-adapter",
    "dsh-connector/packages/dsh-connector-shared",
    "dsh-connector/packages/dsh-connector-test-helpers",
    "dsh-connector/integration/*",
    "amenities/connector-amenities",
    "amenities/watchdog",
    "dsh-fishball-instance/packages/*",
    "dsh-fishball-instance/integration/*"
  ],
  "engines": {
    "node": ">=22.14",
    "dsh": ">=0.2.1-rc.5"
  },
  "scripts": {
    "test": "node dsh-fishball/scripts/test.mjs",
    "test:release": "node scripts/test-release.mjs",
    "pack:v3": "node dsh-fishball/scripts/pack-v3.mjs",
    "pack:v3:check": "node dsh-fishball/scripts/pack-v3.mjs --check"
  }
}
