{
  "name": "dsh-fishball",
  "private": true,
  "description": "Fishball for DeepSeek Harness: fishball-core (core + UI components), the amenities fishball-board, fishball-heartbeat and fishball-taskboard (each its own package) with their fishball-amenities umbrella, and fishball-shared. The root is not a plugin package.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/fishball-board",
    "packages/fishball-heartbeat",
    "packages/fishball-taskboard",
    "packages/fishball-amenities",
    "packages/shared",
    "packages/test-helpers",
    "packages/integration-*"
  ],
  "engines": {
    "node": ">=22.14",
    "dsh": ">=0.2.1-rc.5"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:v3": "node test/run-v3.mjs",
    "test:affected": "node test/run-affected.mjs",
    "test:all": "node test/run-affected.mjs --all",
    "test:release-check": "node test/run-affected.mjs --suite=release.pack,dsh-instance.placement-install,dsh-instance.placement,contract.package-boundaries --release-check",
    "test:map": "node test/run-affected.mjs --check",
    "pack:v3": "node scripts/pack-v3.mjs",
    "pack:v3:check": "node scripts/pack-v3.mjs --check"
  }
}
