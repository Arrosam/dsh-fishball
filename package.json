{
  "name": "dsh-fishball-bundle",
  "version": "1.0.0-alpha.3",
  "description": "All-in-one Fishball embedded edition for DeepSeek Harness (DSH): bundles dsh-agent-connector, dsh-connector-adapter, dsh-connector-watchdog, and dsh-instance in one install.",
  "icon": "./assets/fishball-icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arrosam/dsh-fishball-bundle.git"
  },
  "publishConfig": {
    "tag": "alpha",
    "access": "public"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.amenities.js",
    "assets/fishball-icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.14",
    "dsh": ">=0.2.1-rc.5"
  },
  "dependencies": {
    "dsh-agent-connector": "1.0.0-alpha.3",
    "dsh-connector-adapter": "1.0.0-alpha.1",
    "dsh-connector-watchdog": "1.0.0-alpha.2",
    "dsh-instance": "1.0.0-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-preset": "*",
    "@deepseek-ai/dsh-app-boot": "*",
    "@deepseek-ai/dsh-atomic-write": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/dsh-tool-fs": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-user-approval": "*",
    "@deepseek-ai/schemastery": "*",
    "yaml": "*",
    "zod": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
