{
  "name": "dsh-fishball",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "description": "Native DSH fishball memory and assistant preview",
  "exports": {
    ".": "./src/index.mjs",
    "./runtime": "./src/runtime-plugin.mjs",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:host": "node --test test/*.test.mjs",
    "host:smoke": "node scripts/host-smoke.mjs",
    "host:setup": "node scripts/dsh-web-setup.mjs",
    "host:web": "node scripts/dsh-web.mjs",
    "host:profile-smoke": "node scripts/web-profile-smoke.mjs",
    "client:build": "node scripts/build-client.mjs",
    "client:check": "node scripts/build-client.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1"
  },
  "license": "MIT"
}
