        "resume",
        "dispatch",
        "request_cancel",
        "query",
        "reconcile",
        "request_handoff",
        "verify_handoff"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionRef",
        "actionDigest"
