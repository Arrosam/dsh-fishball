      "properties": {
        "actionRef": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/ref"
        },
        "actionDigest": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/ref"
        }
      }
    },
