{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bubbles:w2-prep:coordinator-context:v1",
  "title": "Mock-only coordinator and context candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "scope",
    "taskVersion",
    "authEpoch",
    "operation",
    "evidence",
    "payload"
  ],
  "properties": {
    "contractVersion": {
      "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/contractVersion"
    },
    "scope": {
      "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/scope"
    },
    "taskVersion": {
      "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/version"
    },
    "authEpoch": {
      "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/epoch"
    },
    "operation": {
      "enum": [
        "register_intake",
        "revise_task",
        "request_stop",
        "clarify",
        "assemble_context",
        "coordinator_outcome"
      ]
    },
    "evidence": {
      "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/evidence"
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "register_intake"
        },
        "payload": {
          "$ref": "#/$defs/intake"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "revise_task"
        },
        "payload": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "request_stop"
        },
        "payload": {
          "$ref": "#/$defs/stop"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "clarify"
        },
        "payload": {
          "$ref": "#/$defs/clarification"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "assemble_context"
        },
        "payload": {
          "$ref": "#/$defs/context"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "coordinator_outcome"
        },
        "payload": {
          "$ref": "#/$defs/outcome"
        }
      }
    }
  ],
  "$defs": {
    "ref": {
      "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/ref"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIdentity",
        "payloadRef",
        "payloadDigest",
        "recordedOrder",
        "classification"
      ],
      "properties": {
        "sourceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providerRef",
            "sourceRef",
            "eventRef"
          ],
          "properties": {
            "providerRef": {
              "$ref": "#/$defs/ref"
            },
            "sourceRef": {
              "$ref": "#/$defs/ref"
            },
            "eventRef": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "payloadRef": {
          "$ref": "#/$defs/ref"
        },
        "payloadDigest": {
          "$ref": "#/$defs/ref"
        },
        "recordedOrder": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/version"
        },
        "classification": {
          "enum": [
            "pending",
            "new_task",
            "supplement",
            "control"
          ]
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "materialRef",
        "materialDigest",
        "changedFields"
      ],
      "properties": {
        "binding": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/binding"
        },
        "materialRef": {
          "$ref": "#/$defs/ref"
        },
        "materialDigest": {
          "$ref": "#/$defs/ref"
        },
        "changedFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "goal",
              "constraints",
              "pending_decisions",
              "priority"
            ]
          }
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "cancellation"
      ],
      "properties": {
        "binding": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/binding"
        },
        "cancellation": {
          "const": "requested"
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "batchRef",
        "decisionRefs",
        "dependentBranchRefs",
        "state"
      ],
      "properties": {
        "binding": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/binding"
        },
        "batchRef": {
          "$ref": "#/$defs/ref"
        },
        "decisionRefs": {
          "$ref": "#/$defs/refs"
        },
        "dependentBranchRefs": {
          "$ref": "#/$defs/refs"
        },
        "state": {
          "enum": [
            "awaiting",
            "answered",
            "withdrawn"
          ]
        },
        "answerRef": {
          "$ref": "#/$defs/ref"
        },
        "answerDigest": {
          "$ref": "#/$defs/ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "answered"
              }
            }
          },
          "then": {
            "required": [
              "answerRef",
              "answerDigest"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "answerRef"
                  ]
                },
                {
                  "required": [
                    "answerDigest"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialRef",
        "digest",
        "sourceScope",
        "sourceTaskVersion",
        "materialKind",
        "observedAt",
        "freshness"
      ],
      "properties": {
        "materialRef": {
          "$ref": "#/$defs/ref"
        },
        "digest": {
          "$ref": "#/$defs/ref"
        },
        "sourceScope": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/scope"
        },
        "sourceTaskVersion": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/version"
        },
        "observedAt": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/time"
        },
        "freshness": {
          "enum": [
            "snapshot",
            "requery_required"
          ]
        },
        "generatedAt": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/time"
        },
        "sourceRefs": {
          "$ref": "#/$defs/refs"
        },
        "materialKind": {
          "enum": [
            "current_instruction",
            "ledger",
            "host_snapshot",
            "task_material",
            "summary"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "materialKind": {
                "const": "summary"
              }
            }
          },
          "then": {
            "required": [
              "generatedAt",
              "sourceRefs"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "generatedAt"
                  ]
                },
                {
                  "required": [
                    "sourceRefs"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "briefingRef",
        "briefingDigest",
        "ledgerRead",
        "goalRef",
        "constraintsRef",
        "pendingDecisionsRef",
        "completedStepsRef",
        "materials",
        "conflicts",
        "limit"
      ],
      "properties": {
        "briefingRef": {
          "$ref": "#/$defs/ref"
        },
        "briefingDigest": {
          "$ref": "#/$defs/ref"
        },
        "ledgerRead": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "taskVersion",
            "authEpoch"
          ],
          "properties": {
            "evidence": {
              "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/evidence"
            },
            "taskVersion": {
              "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/version"
            },
            "authEpoch": {
              "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/epoch"
            }
          }
        },
        "goalRef": {
          "$ref": "#/$defs/ref"
        },
        "constraintsRef": {
          "$ref": "#/$defs/ref"
        },
        "pendingDecisionsRef": {
          "$ref": "#/$defs/ref"
        },
        "completedStepsRef": {
          "$ref": "#/$defs/ref"
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/material"
          }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "winningRef",
              "supersededRef",
              "reason"
            ],
            "properties": {
              "winningRef": {
                "$ref": "#/$defs/ref"
              },
              "supersededRef": {
                "$ref": "#/$defs/ref"
              },
              "reason": {
                "enum": [
                  "newer_instruction",
                  "ledger_authority",
                  "source_unavailable"
                ]
              }
            }
          }
        },
        "limit": {
          "$ref": "#/$defs/limit"
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "accountingEvidence",
        "beforeRelation",
        "decision"
      ],
      "properties": {
        "policyRef": {
          "$ref": "#/$defs/ref"
        },
        "accountingEvidence": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/evidence"
        },
        "beforeRelation": {
          "enum": [
            "below",
            "at",
            "above"
          ]
        },
        "decision": {
          "enum": [
            "ready",
            "compressed",
            "rejected"
          ]
        },
        "afterRelation": {
          "enum": [
            "below",
            "at"
          ]
        },
        "coverageEvidence": {
          "$ref": "urn:bubbles:w2-prep:common:v1#/$defs/evidence"
        }
      },
      "oneOf": [
        {
          "properties": {
            "decision": {
              "const": "ready"
            },
            "beforeRelation": {
              "enum": [
                "below",
                "at"
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "afterRelation"
                ]
              },
              {
                "required": [
                  "coverageEvidence"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "decision": {
              "const": "compressed"
            }
          },
          "required": [
            "afterRelation",
            "coverageEvidence"
          ]
        },
        {
          "properties": {
            "decision": {
              "const": "rejected"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "afterRelation"
                ]
              },
              {
                "required": [
                  "coverageEvidence"
                ]
              }
            ]
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandRef",
        "outcome",
        "code"
      ],
      "properties": {
        "commandRef": {
          "$ref": "#/$defs/ref"
        },
        "outcome": {
          "enum": [
            "accepted",
            "conflict",
            "rejected",
            "recovery_required"
          ]
        },
        "code": {
          "enum": [
            "registered",
            "duplicate",
            "revision_recorded",
            "clarification_pending",
            "stop_requested",
            "stop_observed",
            "effect_completed",
            "stale_version",
            "scope_mismatch",
            "source_missing",
            "context_limit",
            "capability_unavailable",
            "storage_fault",
            "unknown_outcome"
          ]
        },
        "cancellation": {
          "enum": [
            "requested",
            "observed_stopped",
            "unknown",
            "completed_effect"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "const": "accepted"
            },
            "code": {
              "enum": [
                "registered",
                "duplicate",
                "revision_recorded",
                "clarification_pending"
              ]
            }
          },
          "not": {
            "required": [
              "cancellation"
            ]
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "accepted"
            },
            "code": {
              "const": "stop_requested"
            },
            "cancellation": {
              "const": "requested"
            }
          },
          "required": [
            "cancellation"
          ]
        },
        {
          "properties": {
            "outcome": {
              "const": "accepted"
            },
            "code": {
              "const": "stop_observed"
            },
            "cancellation": {
              "const": "observed_stopped"
            }
          },
          "required": [
            "cancellation"
          ]
        },
        {
          "properties": {
            "outcome": {
              "const": "accepted"
            },
            "code": {
              "const": "effect_completed"
            },
            "cancellation": {
              "const": "completed_effect"
            }
          },
          "required": [
            "cancellation"
          ]
        },
        {
          "properties": {
            "outcome": {
              "const": "conflict"
            },
            "code": {
              "const": "stale_version"
            }
          },
          "not": {
            "required": [
              "cancellation"
            ]
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "rejected"
            },
            "code": {
              "enum": [
                "scope_mismatch",
                "source_missing",
                "context_limit",
                "capability_unavailable",
                "storage_fault"
              ]
            }
          },
          "not": {
            "required": [
              "cancellation"
            ]
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "recovery_required"
            },
            "code": {
              "const": "unknown_outcome"
            },
            "cancellation": {
              "const": "unknown"
            }
          }
        }
      ]
    }
  }
}
